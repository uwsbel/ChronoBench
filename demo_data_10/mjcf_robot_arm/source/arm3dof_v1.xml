<mujoco model="arm3dof">
  <!-- A 3-DOF serial arm standing on the ground: base yaw about z, shoulder and elbow pitch
       about y. Explicit inertial blocks; position actuators (the reference trajectory comes
       from the controller, stated in the task text). Units: m, kg, s; z is up. -->
  <option gravity="0 0 -9.81" timestep="0.001"/>
  <worldbody>
    <body name="column" pos="0 0 0">
      <joint name="yaw" type="hinge" axis="0 0 1" pos="0 0 0"/>
      <inertial pos="0 0 0.2" mass="2.0" diaginertia="0.0266667 0.0266667 0.002"/>
      <geom name="column_geom" type="capsule" fromto="0 0 0  0 0 0.4" size="0.04"/>
      <body name="upper_arm" pos="0 0 0.4">
        <joint name="shoulder" type="hinge" axis="0 1 0" pos="0 0 0"/>
        <inertial pos="0 0 0.25" mass="1.0" diaginertia="0.0208333 0.0208333 0.0005"/>
        <geom name="upper_geom" type="capsule" fromto="0 0 0  0 0 0.5" size="0.03"/>
        <body name="forearm" pos="0 0 0.5">
          <joint name="elbow" type="hinge" axis="0 1 0" pos="0 0 0"/>
          <inertial pos="0 0 0.25" mass="1.0" diaginertia="0.0208333 0.0208333 0.0005"/>
          <geom name="fore_geom" type="capsule" fromto="0 0 0  0 0 0.5" size="0.025"/>
          <site name="ee" pos="0 0 0.5"/>
        </body>
      </body>
    </body>
  </worldbody>
  <actuator>
    <position name="yaw_servo" joint="yaw" kp="800"/>
    <position name="shoulder_servo" joint="shoulder" kp="800"/>
    <position name="elbow_servo" joint="elbow" kp="800"/>
  </actuator>
</mujoco>
