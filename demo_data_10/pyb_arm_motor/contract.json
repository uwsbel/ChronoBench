{
  "task": "pyb_arm_motor",
  "axis": "cross-simulator-conversion-pybullet",
  "simulator": "pychrono",
  "source": "CONVERSION shape, third ecosystem (PyBullet -> PyChrono, IMPERATIVE source): the prompt embeds a complete PyBullet script (source/pyb_arm_v*.py: createMultiBody link arrays, changeDynamics inertias, setJointMotorControl2 velocity control, an explicitly applied viscous elbow torque) and the candidate emits an equivalent PyChrono script. Triple-validated: the RK4 oracle (pendulum with prescribed moving pivot), the PyBullet SOURCE run in a disposable pybullet conda env, and the PyChrono reference agree on every graded value to 4 decimals. The drive uses a 0.5 s soft-start ramp BY DESIGN: a velocity-step motor start is an impulsive constraint that kicks the free pendulum (3.6x amplitude vs the smooth oracle, measured during calibration)",
  "scoring": {
    "weights": {"L1": 0.30, "L2": 0.20, "L3": 0.50},
    "invariant_fail_cap": 40
  },
  "turns": [
    {
      "turn": 1,
      "params": {"L1": 0.4, "L2": 0.5, "m1": 0.5, "m2": 0.3, "omega": 1.5, "b_elbow": 0.05, "t_ramp": 0.5, "theta_tail_oracle": 0.2015, "theta_max_oracle": 0.3057},
      "probe_vector": ["pybullet-imperative-conversion", "createmultibody-link-arrays", "velocity-motor-soft-start", "free-joint-idiom", "viscous-joint-damper", "instrumented-observable"],
      "run": {
        "entry": "truth1.py",
        "timeout": 120,
        "expect_csv": "out.csv",
        "expect_json_keys": ["theta_max", "omega_drive"]
      },
      "L2_caps": {
        "speed_motor": "ChLinkMotorRotationSpeed|ChLinkMotorRotationAngle",
        "free_revolute": "ChLinkLockRevolute|ChLinkMateRevolute",
        "damper": "ChLinkRSDA"
      },
      "derive": [
        {"name": "theta_tail", "kind": "max_abs", "csv": "out.csv", "column": "theta", "time_column": "t", "t_min": 7.0},
        {"name": "theta_max", "kind": "max_abs", "csv": "out.csv", "column": "theta"},
