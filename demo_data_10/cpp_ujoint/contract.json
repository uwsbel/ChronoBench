{
  "task": "cpp_ujoint",
  "axis": "source-translation-cpp",
  "simulator": "pychrono",
  "source": "TRANSLATION shape: the prompt embeds the complete C++ demo_MBS_ujoint.cpp (projectchrono/chrono src/demos/mbs, copy in source/) and the candidate must emit an equivalent headless PyChrono script. Bands anchored to the independent Cardan-joint closed form in oracle.py (omega2 in [omega1 cos b, omega1 / cos b], signed NEGATIVE by the demo's motor body order); Chrono agrees with the closed form to 4 decimals on the pinned build",
  "scoring": {
    "weights": {"L1": 0.30, "L2": 0.20, "L3": 0.50},
    "invariant_fail_cap": 40
  },
  "turns": [
    {
      "turn": 1,
      "params": {"beta_deg": 30.0, "omega1": 1.0, "hl": 2.0, "step": 5e-3, "t_end": 10.0, "signed_omega2_min": -1.1547, "signed_omega2_max": -0.8660},
      "probe_vector": ["cpp-to-python-translation", "universal-joint", "rotation-motor-ramp", "joint-frame-orientation", "headless-strip-visualization", "instrumented-observable"],
      "run": {
        "entry": "truth1.py",
        "timeout": 120,
        "expect_csv": "out.csv",
        "expect_json_keys": ["omega2_min", "omega2_max", "omega1_mean"]
      },
      "L2_caps": {
        "universal_joint": "ChLinkUniversal",
        "motor": "ChLinkMotorRotationAngle|ChLinkMotorRotationSpeed",
        "second_support": "ChLinkLockCylindrical|ChLinkLockRevolute"
      },
      "derive": [
        {"name": "omega2_min", "kind": "min", "csv": "out.csv", "column": "w2", "time_column": "t", "t_min": 2.0},
        {"name": "omega2_max", "kind": "max", "csv": "out.csv", "column": "w2", "time_column": "t", "t_min": 2.0},
        {"name": "omega1_mean", "kind": "mean", "csv": "out.csv", "column": "w1", "time_column": "t", "t_min": 2.0}
      ],
      "L3": [
        {"kind": "range", "key": "omega2_min", "lo": -1.21, "hi": -1.10,
         "desc": "Cardan trough: -omega1/cos(30) = -1.1547 (signed; the demo's motor body order spins the shafts in negative local z); a mis-transcribed bend angle collapses the oscillation and fails"},
        {"kind": "range", "key": "omega2_max", "lo": -0.905, "hi": -0.83,
         "desc": "Cardan crest: -omega1*cos(30) = -0.8660"},
        {"kind": "range", "key": "omega1_mean", "lo": -1.03, "hi": -0.97,
         "desc": "the input shaft is driven at exactly 1 rad/s (ramp slope 1, demo convention)"}
      ]
    },
    {
      "turn": 2,
      "params": {"beta_deg": 45.0, "omega1": 1.0, "signed_omega2_min": -1.4142, "signed_omega2_max": -0.7071},
      "probe_vector": ["parameter-propagation", "bend-angle-drives-all-frames", "instrumented-observable"],
      "run": {
        "entry": "truth2.py",
        "timeout": 120,
        "expect_csv": "out.csv",
        "expect_json_keys": ["omega2_min", "omega2_max", "omega1_mean"]
      },
      "L2_caps": {
        "universal_joint": "ChLinkUniversal",
        "motor": "ChLinkMotorRotationAngle|ChLinkMotorRotationSpeed",
        "second_support": "ChLinkLockCylindrical|ChLinkLockRevolute"
      },
      "derive": [
        {"name": "omega2_min", "kind": "min", "csv": "out.csv", "column": "w2", "time_column": "t", "t_min": 2.0},
        {"name": "omega2_max", "kind": "max", "csv": "out.csv", "column": "w2", "time_column": "t", "t_min": 2.0},
        {"name": "omega1_mean", "kind": "mean", "csv": "out.csv", "column": "w1", "time_column": "t", "t_min": 2.0}
      ],
      "L3": [
        {"kind": "range", "key": "omega2_min", "lo": -1.48, "hi": -1.35,
         "desc": "45-deg trough: -1/cos(45) = -1.4142; an unmodified 30-deg candidate (-1.1547) fails high"},
        {"kind": "range", "key": "omega2_max", "lo": -0.74, "hi": -0.675,
         "desc": "45-deg crest: -cos(45) = -0.7071; an unmodified candidate (-0.8660) fails low"},
        {"kind": "range", "key": "omega1_mean", "lo": -1.03, "hi": -0.97,
         "desc": "drive rate unchanged"}
      ]
    },
    {
      "turn": 3,
      "params": {"beta_deg": 45.0, "omega1": 2.0, "signed_omega2_min": -2.8284, "signed_omega2_max": -1.4142, "osc_period_s": 1.5708},
      "probe_vector": ["drive-rate-scaling", "oscillation-frequency-2x-shaft", "instrumented-observable"],
      "run": {
        "entry": "truth3.py",
        "timeout": 120,
        "expect_csv": "out.csv",
        "expect_json_keys": ["omega2_min", "omega2_max", "omega1_mean"]
      },
      "L2_caps": {
        "universal_joint": "ChLinkUniversal",
        "motor": "ChLinkMotorRotationAngle|ChLinkMotorRotationSpeed",
        "second_support": "ChLinkLockCylindrical|ChLinkLockRevolute"
      },
      "derive": [
        {"name": "omega2_min", "kind": "min", "csv": "out.csv", "column": "w2", "time_column": "t", "t_min": 2.0},
        {"name": "omega2_max", "kind": "max", "csv": "out.csv", "column": "w2", "time_column": "t", "t_min": 2.0},
        {"name": "omega1_mean", "kind": "mean", "csv": "out.csv", "column": "w1", "time_column": "t", "t_min": 2.0},
        {"name": "w2_period", "kind": "period", "csv": "out.csv", "column": "w2", "time_column": "t", "t_min": 2.0, "about": -2.0}
      ],
      "L3": [
        {"kind": "range", "key": "omega2_min", "lo": -2.96, "hi": -2.70,
         "desc": "doubled drive: -2/cos(45) = -2.8284; a still-1-rad/s candidate fails"},
        {"kind": "range", "key": "omega2_max", "lo": -1.48, "hi": -1.35,
         "desc": "doubled drive crest: -2*cos(45) = -1.4142"},
        {"kind": "range", "key": "omega1_mean", "lo": -2.06, "hi": -1.94,
         "desc": "the drive rate actually doubled"},
        {"kind": "range", "key": "w2_period", "lo": 1.45, "hi": 1.70,
         "desc": "the speed oscillation completes every pi/omega1 = 1.5708 s (twice per shaft revolution), measured from crossings of the drive level"}
      ]
    }
  ]
}
