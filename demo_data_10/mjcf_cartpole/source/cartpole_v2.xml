<mujoco model="cartpole_hanging_light">
  <!-- A cart free to slide along x, with a uniform-rod pole hanging BELOW it on a hinge.
       Explicit inertial blocks make the conversion unambiguous. Units: m, kg, s; z is up. -->
  <option gravity="0 0 -9.81" timestep="0.001"/>
  <worldbody>
    <body name="cart" pos="0 0 1">
      <joint name="slide_x" type="slide" axis="1 0 0"/>
      <inertial pos="0 0 0" mass="0.5" diaginertia="0.05 0.05 0.05"/>
      <geom name="cart_box" type="box" size="0.15 0.10 0.05"/>
      <body name="pole" pos="0 0 0">
        <joint name="hinge_y" type="hinge" axis="0 1 0" pos="0 0 0"/>
        <inertial pos="0 0 -0.5" mass="0.5" diaginertia="0.0416667 0.0416667 0.0001"/>
        <geom name="pole_rod" type="capsule" fromto="0 0 0  0 0 -1" size="0.02"/>
      </body>
    </body>
  </worldbody>
</mujoco>
