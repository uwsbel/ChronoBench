{
  "task": "slider_crank",
  "axis": "mechanism-kinematics-constraints",
  "simulator": "pychrono",
  "source": "demo_data/slider_crank (ported to 10.0) + analytic inline-crank stroke",
  "probe_vector": ["closed-kinematic-loop", "motor-actuation", "prismatic+revolute-joints", "instrumented-observable"],
  "turn": 1,
  "run": {
    "entry": "truth1.py",
    "timeout": 120,
    "expect_csv": "out.csv",
    "expect_json_keys": ["stroke", "crank_rad"]
  },
  "L2_caps": {
    "motor": "ChLinkMotorRotationSpeed",
    "prismatic_joint": "ChLinkLockPrismatic",
    "revolute_joint": "ChLinkLockRevolute"
  },
  "L3": [
    {"kind": "rel_tol", "key": "stroke", "target": 0.8, "tol": 0.06,
     "desc": "inline slider-crank piston stroke = 2*crank_rad = 0.8 m"}
  ]
}
