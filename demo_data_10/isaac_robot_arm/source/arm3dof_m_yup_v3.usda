#usda 1.0
(
    defaultPrim = "World"
    metersPerUnit = 1.0
    kilogramsPerUnit = 1.0
    upAxis = "Y"
    doc = """The SAME physical arm as arm3dof_cm_v2 (column 0.30 m, upper arm 0.40 m, forearm
    0.80 m), re-exported with metersPerUnit = 1.0 and upAxis = Y: lengths rescaled to meters,
    axes permuted (up is now Y; the yaw joint spins about Y; the pitch joints spin about X; the
    yaw-sweep horizontal direction is now X). Nothing physical changed."""
)

def Xform "World"
{
    def PhysicsScene "PhysicsScene"
    {
        vector3f physics:gravityDirection = (0, -1, 0)
        float physics:gravityMagnitude = 9.81
    }

    def Xform "Arm" (
        prepend apiSchemas = ["PhysicsArticulationRootAPI"]
    )
    {
        def Xform "Column" (
            prepend apiSchemas = ["PhysicsRigidBodyAPI", "PhysicsMassAPI"]
        )
        {
            double3 xformOp:translate = (0, 0, 0)
            uniform token[] xformOpOrder = ["xformOp:translate"]
            float physics:mass = 2.0
            point3f physics:centerOfMass = (0, 0.15, 0)
            float3 physics:diagonalInertia = (0.015, 0.0002, 0.015)

            def Capsule "Geom"
            {
                uniform token axis = "Y"
                double height = 0.26
                double radius = 0.04
                double3 xformOp:translate = (0, 0.15, 0)
                uniform token[] xformOpOrder = ["xformOp:translate"]
            }
        }

        def PhysicsRevoluteJoint "Yaw" (
            prepend apiSchemas = ["PhysicsDriveAPI:angular"]
        )
        {
            rel physics:body1 = </World/Arm/Column>
            uniform token physics:axis = "Y"
            point3f physics:localPos0 = (0, 0, 0)
            point3f physics:localPos1 = (0, 0, 0)
            float drive:angular:physics:stiffness = 10000
            float drive:angular:physics:damping = 100
            float drive:angular:physics:targetPosition = 0
        }

        def Xform "UpperArm" (
            prepend apiSchemas = ["PhysicsRigidBodyAPI", "PhysicsMassAPI"]
        )
        {
            double3 xformOp:translate = (0, 0.30, 0)
            uniform token[] xformOpOrder = ["xformOp:translate"]
            float physics:mass = 1.2
            point3f physics:centerOfMass = (0, 0.20, 0)
            float3 physics:diagonalInertia = (0.016, 0.00015, 0.016)

            def Capsule "Geom"
            {
                uniform token axis = "Y"
                double height = 0.34
                double radius = 0.03
                double3 xformOp:translate = (0, 0.20, 0)
                uniform token[] xformOpOrder = ["xformOp:translate"]
            }
        }

        def PhysicsRevoluteJoint "Shoulder" (
            prepend apiSchemas = ["PhysicsDriveAPI:angular"]
        )
        {
            rel physics:body0 = </World/Arm/Column>
            rel physics:body1 = </World/Arm/UpperArm>
            uniform token physics:axis = "X"
            point3f physics:localPos0 = (0, 0.30, 0)
            point3f physics:localPos1 = (0, 0, 0)
            float drive:angular:physics:stiffness = 10000
            float drive:angular:physics:damping = 100
            float drive:angular:physics:targetPosition = 0
        }

        def Xform "Forearm" (
            prepend apiSchemas = ["PhysicsRigidBodyAPI", "PhysicsMassAPI"]
        )
        {
            double3 xformOp:translate = (0, 0.70, 0)
            uniform token[] xformOpOrder = ["xformOp:translate"]
            float physics:mass = 1.2
            point3f physics:centerOfMass = (0, 0.40, 0)
            float3 physics:diagonalInertia = (0.064, 0.00016, 0.064)

            def Capsule "Geom"
            {
                uniform token axis = "Y"
                double height = 0.74
                double radius = 0.025
                double3 xformOp:translate = (0, 0.40, 0)
                uniform token[] xformOpOrder = ["xformOp:translate"]
            }
        }

        def PhysicsRevoluteJoint "Elbow" (
            prepend apiSchemas = ["PhysicsDriveAPI:angular"]
        )
        {
            rel physics:body0 = </World/Arm/UpperArm>
            rel physics:body1 = </World/Arm/Forearm>
            uniform token physics:axis = "X"
            point3f physics:localPos0 = (0, 0.40, 0)
            point3f physics:localPos1 = (0, 0, 0)
            float drive:angular:physics:stiffness = 10000
            float drive:angular:physics:damping = 100
            float drive:angular:physics:targetPosition = 0
        }
    }
}
