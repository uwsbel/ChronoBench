#usda 1.0
(
    defaultPrim = "World"
    metersPerUnit = 0.01
    kilogramsPerUnit = 1.0
    upAxis = "Z"
    doc = """Isaac Sim articulation: a 3-DOF serial arm (base yaw about Z, shoulder and elbow
    pitch about Y), authored in CENTIMETERS (metersPerUnit = 0.01): column 30, upper arm 40,
    forearm 80; the end effector is the forearm tip, 80 beyond the elbow. High-stiffness
    position DriveAPIs on all three joints track a controller reference (stated in the task
    text). Joints with no body0 are anchored to the world."""
)

def Xform "World"
{
    def PhysicsScene "PhysicsScene"
    {
        vector3f physics:gravityDirection = (0, 0, -1)
        float physics:gravityMagnitude = 981
    }

    def Xform "Arm" (
        prepend apiSchemas = ["PhysicsArticulationRootAPI"]
    )
    {
        def Xform "Column" (
            prepend apiSchemas = ["PhysicsRigidBodyAPI", "PhysicsMassAPI"]
        )
        {
            double3 xformOp:translate = (0, 0, 0)
            uniform token[] xformOpOrder = ["xformOp:translate"]
            float physics:mass = 2.0
            point3f physics:centerOfMass = (0, 0, 15)
            float3 physics:diagonalInertia = (150, 150, 2)

            def Capsule "Geom"
            {
                double height = 26
                double radius = 4
                double3 xformOp:translate = (0, 0, 15)
                uniform token[] xformOpOrder = ["xformOp:translate"]
            }
        }

        def PhysicsRevoluteJoint "Yaw" (
            prepend apiSchemas = ["PhysicsDriveAPI:angular"]
        )
        {
            rel physics:body1 = </World/Arm/Column>
            uniform token physics:axis = "Z"
            point3f physics:localPos0 = (0, 0, 0)
            point3f physics:localPos1 = (0, 0, 0)
            float drive:angular:physics:stiffness = 10000
            float drive:angular:physics:damping = 100
            float drive:angular:physics:targetPosition = 0
        }

        def Xform "UpperArm" (
            prepend apiSchemas = ["PhysicsRigidBodyAPI", "PhysicsMassAPI"]
        )
        {
            double3 xformOp:translate = (0, 0, 30)
            uniform token[] xformOpOrder = ["xformOp:translate"]
            float physics:mass = 1.2
            point3f physics:centerOfMass = (0, 0, 20)
            float3 physics:diagonalInertia = (160, 160, 1.5)

            def Capsule "Geom"
            {
                double height = 34
                double radius = 3
                double3 xformOp:translate = (0, 0, 20)
                uniform token[] xformOpOrder = ["xformOp:translate"]
            }
        }

        def PhysicsRevoluteJoint "Shoulder" (
            prepend apiSchemas = ["PhysicsDriveAPI:angular"]
        )
        {
            rel physics:body0 = </World/Arm/Column>
            rel physics:body1 = </World/Arm/UpperArm>
            uniform token physics:axis = "Y"
            point3f physics:localPos0 = (0, 0, 30)
            point3f physics:localPos1 = (0, 0, 0)
            float drive:angular:physics:stiffness = 10000
            float drive:angular:physics:damping = 100
            float drive:angular:physics:targetPosition = 0
        }

        def Xform "Forearm" (
            prepend apiSchemas = ["PhysicsRigidBodyAPI", "PhysicsMassAPI"]
        )
        {
            double3 xformOp:translate = (0, 0, 70)
            uniform token[] xformOpOrder = ["xformOp:translate"]
            float physics:mass = 1.2
            point3f physics:centerOfMass = (0, 0, 40)
            float3 physics:diagonalInertia = (640, 640, 1.6)

            def Capsule "Geom"
            {
                double height = 74
                double radius = 2.5
                double3 xformOp:translate = (0, 0, 40)
                uniform token[] xformOpOrder = ["xformOp:translate"]
            }
        }

        def PhysicsRevoluteJoint "Elbow" (
            prepend apiSchemas = ["PhysicsDriveAPI:angular"]
        )
        {
            rel physics:body0 = </World/Arm/UpperArm>
            rel physics:body1 = </World/Arm/Forearm>
            uniform token physics:axis = "Y"
            point3f physics:localPos0 = (0, 0, 40)
            point3f physics:localPos1 = (0, 0, 0)
            float drive:angular:physics:stiffness = 10000
            float drive:angular:physics:damping = 100
            float drive:angular:physics:targetPosition = 0
        }
    }
}
