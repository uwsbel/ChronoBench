{
  "task": "fea_ancf_beam",
  "axis": "fea-ancf",
  "simulator": "pychrono",
  "source": "Chrono cable-ANCF idiom (demo_FEA_cables); targets from independent oracle.py (Euler-Bernoulli FE + closed forms, circular section), NOT a Chrono run",
  "scoring": {
    "weights": {"L1": 0.30, "L2": 0.20, "L3": 0.50},
    "invariant_fail_cap": 40
  },
  "turns": [
    {
      "turn": 1,
      "params": {"L": 1.0, "d": 0.02, "E": 2.0e10, "rho": 7800.0, "F_tip": 2.0, "delta_oracle": 0.004244131815783876},
      "probe_vector": ["ancf-cable-elements", "section/material-setup", "nonlinear-static-solve", "clamped-node-BC", "instrumented-shape"],
      "run": {
        "entry": "truth1.py",
        "timeout": 180,
        "expect_csv": "out.csv",
        "expect_json_keys": ["tip_deflection", "analytic"]
      },
      "L2_caps": {
        "fea_mesh": "ChMesh",
        "ancf_cable": "ChElementCableANCF|ChBuilderCableANCF",
        "cable_section": "ChBeamSectionCable",
        "static_solve": "DoStaticNonlinear|DoStatic"
      },
      "derive": [
        {"name": "tip_defl_meas", "kind": "max_abs", "csv": "out.csv", "column": "y"}
      ],
      "L3": [
        {"kind": "rel_tol", "key": "tip_defl_meas", "target": 0.004244131815783876, "tol": 0.06,
         "desc": "ANCF cable cantilever tip deflection must match Euler-Bernoulli F*L^3/(3*E*I), I=pi*d^4/64; L=1,d=0.02,E=2e10,F=2 (independent oracle; Chrono reference agrees to 0.002%); MEASURED as max|y| of the logged deflected shape"}
      ]
    },
    {
      "turn": 2,
      "params": {"L": 1.0, "d": 0.02, "E": 2.0e10, "rho": 7800.0, "g": 9.81, "delta_oracle": 0.019129499999999997},
      "probe_vector": ["self-weight-load", "automatic-gravity", "nonlinear-static-solve", "instrumented-shape"],
      "run": {
        "entry": "truth2.py",
        "timeout": 180,
        "expect_csv": "out.csv",
        "expect_json_keys": ["tip_deflection", "analytic"]
      },
      "L2_caps": {
        "fea_mesh": "ChMesh",
        "ancf_cable": "ChElementCableANCF|ChBuilderCableANCF",
        "gravity": "SetAutomaticGravity|SetGravitationalAcceleration",
        "static_solve": "DoStaticNonlinear|DoStatic"
      },
      "derive": [
        {"name": "tip_defl_meas", "kind": "max_abs", "csv": "out.csv", "column": "y"}
      ],
      "L3": [
        {"kind": "rel_tol", "key": "tip_defl_meas", "target": 0.019129499999999997, "tol": 0.06,
         "desc": "self-weight sag q*L^4/(8*E*I), q=rho*A*g (independent oracle; Chrono reference agrees to 0.03%); catches 'tip load left in' (0.0042 fails) and wrong density/section; MEASURED from the logged shape"}
      ]
    },
    {
      "turn": 3,
      "params": {"L": 1.0, "d": 0.02, "E": 2.0e10, "rho": 7800.0, "F_tip": 2.0, "P_mid": 2.0, "delta_oracle": 0.005570423008216337},
      "probe_vector": ["multiple-point-loads", "superposition", "nonlinear-static-solve", "instrumented-shape"],
      "run": {
        "entry": "truth3.py",
        "timeout": 180,
        "expect_csv": "out.csv",
        "expect_json_keys": ["tip_deflection", "analytic"]
      },
      "L2_caps": {
        "fea_mesh": "ChMesh",
        "ancf_cable": "ChElementCableANCF|ChBuilderCableANCF",
        "cable_section": "ChBeamSectionCable",
        "static_solve": "DoStaticNonlinear|DoStatic"
      },
      "derive": [
        {"name": "tip_defl_meas", "kind": "max_abs", "csv": "out.csv", "column": "y"}
      ],
      "L3": [
        {"kind": "rel_tol", "key": "tip_defl_meas", "target": 0.005570423008216337, "tol": 0.06,
         "desc": "tip F plus mid-span P superposition F*L^3/(3*E*I) + 5*P*L^3/(48*E*I) (independent oracle; Chrono reference agrees to 0.003%); catches 'mid load at wrong station' and 'tip-only' (0.0042 fails); MEASURED from the logged shape"}
      ]
    }
  ]
}
