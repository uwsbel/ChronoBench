{
  "task": "gear",
  "axis": "mechanism-gear-train",
  "simulator": "pychrono",
  "source": "demo_data/gear redesigned for 10.0; targets from independent oracle.py (exact rigid-transmission kinematics: external mesh reverses sense, ratio = radii ratio), NOT a Chrono run",
  "scoring": {
    "weights": {"L1": 0.30, "L2": 0.20, "L3": 0.50},
    "invariant_fail_cap": 40
  },
  "turns": [
    {
      "turn": 1,
      "params": {"r1": 0.2, "r2": 0.4, "omega_in": 4.0, "w2_oracle": -2.0},
      "probe_vector": ["gear-constraint", "motor-actuation", "counter-rotation-sign", "instrumented-observable"],
      "run": {
        "entry": "truth1.py",
        "timeout": 120,
        "expect_csv": "out.csv",
        "expect_json_keys": ["w1_mean", "w2_mean", "ratio"]
      },
      "L2_caps": {
        "gear_constraint": "ChLinkLockGear",
        "transmission_ratio": "SetTransmissionRatio",
        "motor": "ChLinkMotorRotationSpeed",
        "revolute_joint": "ChLinkLockRevolute"
      },
      "derive": [
        {"name": "w1_meas", "kind": "mean", "csv": "out.csv", "column": "w1", "time_column": "t", "t_min": 2.0},
        {"name": "w2_meas", "kind": "mean", "csv": "out.csv", "column": "w2", "time_column": "t", "t_min": 2.0}
      ],
      "L3": [
        {"kind": "rel_tol", "key": "w1_meas", "target": 4.0, "tol": 0.05,
         "desc": "drive gear spins at the commanded +4 rad/s about global Z (catches 'motor missing / wrong speed')"},
        {"kind": "rel_tol", "key": "w2_meas", "target": -2.0, "tol": 0.05,
         "desc": "external mesh: w2 = -(r1/r2)*w1 = -2 rad/s (independent oracle); the SIGN enforces counter-rotation, the magnitude the 2:1 ratio; MEASURED from the logged trajectory"}
      ]
    },
    {
      "turn": 2,
      "params": {"r1": 0.2, "r2": 0.6, "omega_in": 4.0, "w2_oracle": -1.3333333333333335},
      "probe_vector": ["parameter-modification", "gear-constraint", "ratio-and-geometry-coupled-change", "instrumented-observable"],
      "run": {
        "entry": "truth2.py",
        "timeout": 120,
        "expect_csv": "out.csv",
        "expect_json_keys": ["w1_mean", "w2_mean", "ratio"]
      },
      "L2_caps": {
        "gear_constraint": "ChLinkLockGear",
        "transmission_ratio": "SetTransmissionRatio",
        "motor": "ChLinkMotorRotationSpeed",
        "revolute_joint": "ChLinkLockRevolute"
      },
      "derive": [
        {"name": "w1_meas", "kind": "mean", "csv": "out.csv", "column": "w1", "time_column": "t", "t_min": 2.0},
        {"name": "w2_meas", "kind": "mean", "csv": "out.csv", "column": "w2", "time_column": "t", "t_min": 2.0}
      ],
      "L3": [
        {"kind": "rel_tol", "key": "w1_meas", "target": 4.0, "tol": 0.05,
         "desc": "drive speed unchanged at +4 rad/s"},
        {"kind": "rel_tol", "key": "w2_meas", "target": -1.3333333333333335, "tol": 0.05,
         "desc": "larger driven gear (r2 0.4->0.6): w2 = -(0.2/0.6)*4 = -4/3 rad/s (independent oracle); catches 'ratio not updated' (-2.0 fails at 50% error)"}
      ]
    },
    {
      "turn": 3,
      "params": {"r1": 0.2, "r2": 0.6, "r3": 0.2, "omega_in": 4.0, "w2_oracle": -1.3333333333333335, "w3_oracle": 4.0},
      "probe_vector": ["extend-second-stage", "gear-constraint", "sense-restored-after-two-meshes", "instrumented-observable"],
      "run": {
        "entry": "truth3.py",
        "timeout": 120,
        "expect_csv": "out.csv",
        "expect_json_keys": ["w1_mean", "w2_mean", "w3_mean"]
      },
      "L2_caps": {
        "gear_constraint": "ChLinkLockGear",
        "transmission_ratio": "SetTransmissionRatio",
        "motor": "ChLinkMotorRotationSpeed",
        "revolute_joint": "ChLinkLockRevolute"
      },
      "derive": [
        {"name": "w1_meas", "kind": "mean", "csv": "out.csv", "column": "w1", "time_column": "t", "t_min": 2.0},
        {"name": "w2_meas", "kind": "mean", "csv": "out.csv", "column": "w2", "time_column": "t", "t_min": 2.0},
        {"name": "w3_meas", "kind": "mean", "csv": "out.csv", "column": "w3", "time_column": "t", "t_min": 2.0}
      ],
      "L3": [
        {"kind": "rel_tol", "key": "w1_meas", "target": 4.0, "tol": 0.05,
         "desc": "drive speed unchanged at +4 rad/s"},
        {"kind": "rel_tol", "key": "w2_meas", "target": -1.3333333333333335, "tol": 0.05,
         "desc": "first stage unchanged: w2 = -4/3 rad/s (independent oracle)"},
        {"kind": "rel_tol", "key": "w3_meas", "target": 4.0, "tol": 0.05,
         "desc": "second external mesh restores the sense: w3 = -(r2/r3)*w2 = +(r1/r3)*w1 = +4 rad/s (independent oracle); the POSITIVE sign is the discriminator (a candidate with one mesh or belt-like behavior lands at -4 and fails at 200% error)"}
      ]
    }
  ]
}
