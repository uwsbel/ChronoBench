{
  "task": "yaml_mbs",
  "axis": "data-import-yaml-declarative",
  "simulator": "pychrono",
  "source": "Chrono MBS-YAML schema (Library/data/yaml/mbs idiom) driven through chrono::parsers::ChParserMbsYAML; the candidate script authors the YAML files inline and loads them; targets from independent oracle.py (inline slider-crank closed forms), NOT a Chrono run",
  "scoring": {
    "weights": {"L1": 0.30, "L2": 0.20, "L3": 0.50},
    "invariant_fail_cap": 40
  },
  "turns": [
    {
      "turn": 1,
      "params": {"r": 0.25, "l": 1.0, "omega": 3.141592653589793, "stroke_oracle": 0.5},
      "probe_vector": ["yaml-model-authoring", "yaml-parser-load", "motor-declaration", "distance-constraint-world-points", "instrumented-observable"],
      "run": {
        "entry": "truth1.py",
        "timeout": 180,
        "expect_csv": "out.csv",
        "expect_json_keys": ["stroke", "r"]
      },
      "L2_caps": {
        "yaml_parser": "ChParserMbsYAML",
        "populate": "Populate",
        "motor_decl": "actuation_type|ROTATION",
        "distance_decl": "DISTANCE"
      },
      "derive": [
        {"name": "stroke_meas", "kind": "range", "csv": "out.csv", "column": "slider_x"}
      ],
      "L3": [
        {"kind": "rel_tol", "key": "stroke_meas", "target": 0.5, "tol": 0.06,
         "desc": "inline slider-crank stroke = 2*r = 0.5 m (independent oracle); MEASURED as range of slider_x; catches the frozen-slider bug (constraint point at the pivot -> stroke 0)"}
      ]
    },
    {
      "turn": 2,
      "params": {"r": 0.4, "l": 1.0, "omega": 3.141592653589793, "stroke_oracle": 0.8},
      "probe_vector": ["yaml-model-modification", "geometry-coupled-change", "instrumented-observable"],
      "run": {
        "entry": "truth2.py",
        "timeout": 180,
        "expect_csv": "out.csv",
        "expect_json_keys": ["stroke", "r"]
      },
      "L2_caps": {
        "yaml_parser": "ChParserMbsYAML",
        "populate": "Populate",
        "motor_decl": "actuation_type|ROTATION",
        "distance_decl": "DISTANCE"
      },
      "derive": [
        {"name": "stroke_meas", "kind": "range", "csv": "out.csv", "column": "slider_x"}
      ],
      "L3": [
        {"kind": "rel_tol", "key": "stroke_meas", "target": 0.8, "tol": 0.06,
         "desc": "crank radius 0.25 -> 0.4 in the DECLARED model: stroke = 0.8 m; the slider location, prismatic location, and constraint points must all move consistently (an unmodified candidate sits at 0.5 and fails at 37%)"}
      ]
    },
    {
      "turn": 3,
      "params": {"r": 0.4, "l": 1.0, "omega": 6.283185307179586, "stroke_oracle": 0.8, "peak_speed_oracle": 2.710687},
      "probe_vector": ["yaml-actuation-change", "velocity-kinematics", "instrumented-observable"],
      "run": {
        "entry": "truth3.py",
        "timeout": 180,
        "expect_csv": "out.csv",
        "expect_json_keys": ["stroke", "r"]
      },
      "L2_caps": {
        "yaml_parser": "ChParserMbsYAML",
        "populate": "Populate",
        "motor_decl": "actuation_type|ROTATION",
        "distance_decl": "DISTANCE"
      },
      "derive": [
        {"name": "stroke_meas", "kind": "range", "csv": "out.csv", "column": "slider_x"},
        {"name": "peak_speed_meas", "kind": "max_speed", "csv": "out.csv", "column": "slider_x", "time_column": "t"}
      ],
      "L3": [
        {"kind": "rel_tol", "key": "stroke_meas", "target": 0.8, "tol": 0.06,
         "desc": "stroke is geometric, unchanged at 0.8 m"},
        {"kind": "rel_tol", "key": "peak_speed_meas", "target": 2.710687, "tol": 0.08,
         "desc": "drive speed doubled in the DECLARED actuation function (omega = 2*pi): peak slider speed = 2.7107 m/s (independent oracle); catches 'speed not changed' (1.355 fails at 50%)"}
      ]
    }
  ]
}
