{
  "task": "pendulum",
  "axis": "mechanism-kinematics-constraints",
  "simulator": "pychrono",
  "source": "demo_data/pendulum (ported to 10.0) + analytic small-angle period",
  "probe_vector": ["revolute-constraint", "frame-reasoning", "instrumented-observable"],
  "turn": 1,
  "run": {
    "entry": "truth1.py",
