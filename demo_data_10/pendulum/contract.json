  "L3": [
    {"kind": "rel_tol", "key": "period_est", "target": 2.0061, "tol": 0.10,
     "desc": "small-angle period T = 2*pi*sqrt(L/g) with L=1.0, g=9.81"},
    {"kind": "max", "key": "theta_max", "bound": 0.10472,
     "desc": "amplitude <= 1.2*theta0 (theta0=5deg); no energy growth"}
  ]
