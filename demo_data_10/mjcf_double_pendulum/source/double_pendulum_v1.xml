<mujoco model="double_pendulum">
  <!-- Two uniform rods on hinges: rod 1 hangs from a fixed pivot at (0,0,2), rod 2 hangs from
       the TIP of rod 1 (note the nested body pos). Explicit inertial blocks make the
       conversion unambiguous. Units: m, kg, s; z is up. -->
  <option gravity="0 0 -9.81" timestep="0.001"/>
  <worldbody>
    <body name="rod1" pos="0 0 2">
      <joint name="hinge1" type="hinge" axis="0 1 0" pos="0 0 0"/>
      <inertial pos="0 0 -0.5" mass="1.0" diaginertia="0.0833333 0.0833333 0.0001"/>
      <geom name="rod1_geom" type="capsule" fromto="0 0 0  0 0 -1" size="0.02"/>
      <body name="rod2" pos="0 0 -1">
        <joint name="hinge2" type="hinge" axis="0 1 0" pos="0 0 0"/>
        <inertial pos="0 0 -0.5" mass="1.0" diaginertia="0.0833333 0.0833333 0.0001"/>
        <geom name="rod2_geom" type="capsule" fromto="0 0 0  0 0 -1" size="0.02"/>
      </body>
    </body>
  </worldbody>
</mujoco>
