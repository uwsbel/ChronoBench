<?xml version="1.0"?>
<!-- ChronoBench import_urdf asset: a single-link compound pendulum (parameter-first).
     Declared physics: arm = slender rod, length 1.0 m along -Y from the joint, mass 2.0 kg,
     COM at (0, -0.5, 0), inertia about the COM: Izz = Ixx = m*L^2/12 = 0.1666667 (slender rod),
     tiny Iyy (about the rod axis). Joint "swing" is a revolute about +Z at the origin.
     Free compound-pendulum period about the pivot: T = 2*pi*sqrt(I_pivot/(m*g*d)),
     I_pivot = Izz_com + m*d^2 = 0.6666667, d = 0.5 -> T = 1.6379 s (see oracle.py). -->
<robot name="chronobench_pendulum">
  <link name="base_link">
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="1.0"/>
      <inertia ixx="0.01" iyy="0.01" izz="0.01" ixy="0" ixz="0" iyz="0"/>
    </inertial>
  </link>
  <link name="arm">
    <inertial>
      <origin xyz="0 -0.5 0" rpy="0 0 0"/>
      <mass value="2.0"/>
      <inertia ixx="0.1666667" iyy="0.0010" izz="0.1666667" ixy="0" ixz="0" iyz="0"/>
    </inertial>
    <visual>
      <origin xyz="0 -0.5 0" rpy="1.5707963 0 0"/>
      <geometry>
        <cylinder radius="0.02" length="1.0"/>
      </geometry>
    </visual>
  </link>
  <joint name="swing" type="revolute">
    <parent link="base_link"/>
    <child link="arm"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
    <axis xyz="0 0 1"/>
    <limit lower="-3.2" upper="3.2" effort="100.0" velocity="20.0"/>
  </joint>
</robot>
