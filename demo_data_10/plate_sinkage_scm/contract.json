{
  "task": "plate_sinkage_scm",
  "axis": "vehicle-terramechanics",
  "simulator": "pychrono",
  "source": "SBEL terramechanics line (bevameter / plate-sinkage) on SCM deformable terrain; targets from the independent Bekker-Wong oracle.py (COARSE band, SCM sinkage ~1.0-1.5x ideal Bekker), NOT a Chrono run",
  "scoring": {
    "weights": {"L1": 0.30, "L2": 0.20, "L3": 0.50},
    "invariant_fail_cap": 40
  },
  "turns": [
    {
      "turn": 1,
      "params": {"Kphi": 2.0e6, "Kc": 0.0, "n": 1.0, "plate_m": [0.2, 0.2, 0.05], "load_N": 500.0, "bekker_sinkage_m": 0.00625},
      "probe_vector": ["scm-deformable-terrain", "bekker-wong-params", "pressure-sinkage", "instrumented-observable"],
      "run": {"entry": "truth1.py", "timeout": 300, "expect_csv": "out.csv", "expect_json_keys": ["sinkage", "load_N"]},
      "L2_caps": {
        "scm_terrain": "SCMTerrain",
        "soil_params": "SetSoilParameters",
        "collision_system": "SetCollisionSystemType",
        "step_loop": "DoStepDynamics"
      },
      "derive": [
        {"name": "sinkage_final", "kind": "final", "csv": "out.csv", "column": "sinkage"}
      ],
      "L3": [
        {"kind": "min", "key": "sinkage_final", "bound": 0.003125,
         "desc": "plate actually sinks: sinkage >= 0.5x Bekker(F=500,Kphi=2e6)=0.00625 (independent coarse-band lower bound; catches 'no sinkage / too stiff')"},
        {"kind": "max", "key": "sinkage_final", "bound": 0.015625,
         "desc": "sinkage <= 2.5x Bekker (coarse-band upper; catches blow-up / plate fell through); SCM runs ~1.0-1.5x the ideal Bekker value"}
      ]
    },
    {
      "turn": 2,
      "params": {"Kphi": 5.0e5, "Kc": 0.0, "n": 1.0, "plate_m": [0.2, 0.2, 0.05], "load_N": 500.0, "bekker_sinkage_m": 0.025},
      "probe_vector": ["parameter-modification", "softer-soil", "pressure-sinkage"],
      "run": {"entry": "truth2.py", "timeout": 300, "expect_csv": "out.csv", "expect_json_keys": ["sinkage", "load_N"]},
      "L2_caps": {
        "scm_terrain": "SCMTerrain",
        "soil_params": "SetSoilParameters",
        "collision_system": "SetCollisionSystemType",
        "step_loop": "DoStepDynamics"
      },
      "derive": [
        {"name": "sinkage_final", "kind": "final", "csv": "out.csv", "column": "sinkage"}
      ],
      "L3": [
        {"kind": "min", "key": "sinkage_final", "bound": 0.0125,
         "desc": "softer soil (Kphi 2e6->5e5) -> deeper: sinkage >= 0.5x Bekker=0.025; the ~0.0077 of an un-softened candidate falls below (encodes softer -> deeper)"},
        {"kind": "max", "key": "sinkage_final", "bound": 0.0625,
         "desc": "sinkage <= 2.5x Bekker (coarse-band upper)"}
      ]
    },
    {
      "turn": 3,
      "params": {"Kphi": 2.0e6, "Kc": 0.0, "n": 1.0, "plate_m": [0.2, 0.2, 0.05], "load_N": 2000.0, "bekker_sinkage_m": 0.025},
      "probe_vector": ["parameter-modification", "heavier-load", "pressure-sinkage"],
      "run": {"entry": "truth3.py", "timeout": 300, "expect_csv": "out.csv", "expect_json_keys": ["sinkage", "load_N"]},
      "L2_caps": {
        "scm_terrain": "SCMTerrain",
        "soil_params": "SetSoilParameters",
        "collision_system": "SetCollisionSystemType",
        "step_loop": "DoStepDynamics"
      },
      "derive": [
        {"name": "sinkage_final", "kind": "final", "csv": "out.csv", "column": "sinkage"}
      ],
      "L3": [
        {"kind": "min", "key": "sinkage_final", "bound": 0.0125,
         "desc": "heavier load (500->2000 N) -> deeper: sinkage >= 0.5x Bekker=0.025; the ~0.0077 of an un-loaded candidate falls below (encodes heavier -> deeper)"},
        {"kind": "max", "key": "sinkage_final", "bound": 0.0625,
         "desc": "sinkage <= 2.5x Bekker (coarse-band upper)"}
      ]
    }
  ]
}
