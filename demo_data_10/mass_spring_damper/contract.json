{
  "task": "mass_spring_damper",
  "axis": "mechanism-kinematics-constraints",
  "simulator": "pychrono",
  "source": "demo_data/mass_spring_damper (ported to 10.0) + analytic damped oscillator",
  "probe_vector": ["TSDA-force-element", "damped-dynamics", "instrumented-observable"],
  "turn": 1,
  "run": {
    "entry": "truth1.py",
    "timeout": 120,
    "expect_csv": "out.csv",
    "expect_json_keys": ["period_d", "zeta_est"]
  },
  "L2_caps": {
    "tsda_spring": "ChLinkTSDA|SpringCoefficient",
    "step_loop": "DoStepDynamics"
  },
  "L3": [
    {"kind": "rel_tol", "key": "period_d", "target": 0.6315, "tol": 0.05,
     "desc": "damped period Td = 2*pi/(wn*sqrt(1-zeta^2)), wn=10, zeta=0.1"},
    {"kind": "rel_tol", "key": "zeta_est", "target": 0.1, "tol": 0.20,
     "desc": "damping ratio zeta = c/(2*sqrt(k*m)) = 0.1 (log-decrement estimate)"}
  ]
}
