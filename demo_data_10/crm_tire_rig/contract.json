{
  "task": "crm_tire_rig",
  "axis": "tire-terramechanics-crm",
  "simulator": "pychrono",
  "source": "Polaris tire on CRM (SPH continuum granular) terrain in a ChTireTestRig (demo_VEH_TireTestRig_CRM idiom, HIP build). No closed-form oracle exists for CRM soil, so the posture is the hmmwv_scm one stated honestly: cross-turn terramechanics LAWS carry the physics (more load -> deeper; more slip -> deeper still), the slip observable is KINEMATIC (both rig speeds are imposed, slip = omega*R/v - 1, load-independent, so it pins the wheel-speed change exactly), and the absolute bands are calibrated on the pinned build and frozen (CONTRACT.md), NOT re-derived from a Chrono run at grade time",
  "scoring": {
    "weights": {"L1": 0.30, "L2": 0.20, "L3": 0.50},
    "invariant_fail_cap": 40
  },
  "turns": [
    {
      "turn": 1,
      "params": {"load": 2500.0, "rpm": 10.0, "long_speed": 0.2, "t_end": 5.0, "z_ref": -0.5457, "dbp_ref": 367.1, "slip_ref": 0.7291},
      "probe_vector": ["tire-test-rig", "json-spec-loading", "crm-terrain-params", "imposed-slip-kinematics", "rig-self-sequencing", "instrumented-observable"],
      "run": {
        "entry": "truth1.py",
        "env_id": "hip",
        "timeout": 900,
        "expect_csv": "out.csv",
        "expect_json_keys": ["z_settled", "dbp_tail", "slip_tail", "load"]
      },
      "L2_caps": {
        "vehicle_module": "pychrono.vehicle",
        "rig": "ChTireTestRig",
        "crm_terrain": "SetTerrainCRM",
        "normal_load": "SetNormalLoad",
        "speed_functions": "SetAngSpeedFunction"
      },
      "derive": [
        {"name": "z_settled", "kind": "mean", "csv": "out.csv", "column": "z", "time_column": "t", "t_min": 4.0},
        {"name": "slip_tail", "kind": "mean", "csv": "out.csv", "column": "slip", "time_column": "t", "t_min": 4.0},
        {"name": "dbp_tail", "kind": "mean", "csv": "out.csv", "column": "dbp", "time_column": "t", "t_min": 4.0}
      ],
      "L3": [
        {"kind": "range", "key": "z_settled", "lo": -0.567, "hi": -0.525,
         "desc": "settled spindle height under 2500 N (calibrated -0.5457); the 5000 N case (-0.5882) fails low, an unloaded/hovering tire fails high"},
        {"kind": "range", "key": "slip_tail", "lo": 0.70, "hi": 0.76,
         "desc": "kinematic slip omega*R/v - 1 with R = 0.330, 10 RPM vs 0.2 m/s -> 0.7291; catches wrong speeds or a wrong RPM conversion"},
        {"kind": "range", "key": "dbp_tail", "lo": 150.0, "hi": 600.0,
         "desc": "drawbar pull at the 2500 N / 10 RPM operating point (calibrated 367 N; generous band, SPH run-to-run variance)"}
      ]
    },
    {
      "turn": 2,
      "params": {"load": 5000.0, "rpm": 10.0, "long_speed": 0.2, "t_end": 5.0, "z_ref": -0.5882, "dbp_ref": 147.2, "slip_ref": 0.7291},
      "probe_vector": ["load-doubling", "load-sinkage-law", "instrumented-observable"],
      "run": {
        "entry": "truth2.py",
        "env_id": "hip",
        "timeout": 900,
        "expect_csv": "out.csv",
        "expect_json_keys": ["z_settled", "dbp_tail", "slip_tail", "load"]
      },
      "L2_caps": {
        "vehicle_module": "pychrono.vehicle",
        "rig": "ChTireTestRig",
        "crm_terrain": "SetTerrainCRM",
        "normal_load": "SetNormalLoad",
        "speed_functions": "SetAngSpeedFunction"
      },
      "derive": [
        {"name": "z_settled", "kind": "mean", "csv": "out.csv", "column": "z", "time_column": "t", "t_min": 4.0},
        {"name": "slip_tail", "kind": "mean", "csv": "out.csv", "column": "slip", "time_column": "t", "t_min": 4.0},
        {"name": "dbp_tail", "kind": "mean", "csv": "out.csv", "column": "dbp", "time_column": "t", "t_min": 4.0}
      ],
      "L3": [
        {"kind": "range", "key": "z_settled", "lo": -0.610, "hi": -0.572,
         "desc": "doubled load MUST sink deeper (calibrated -0.5882, 4.3 cm below turn 1); an unmodified 2500 N candidate (-0.5457) fails high"},
        {"kind": "range", "key": "slip_tail", "lo": 0.70, "hi": 0.76,
         "desc": "slip is kinematic and load-independent: unchanged from turn 1 (0.7291); catches accidental speed edits"},
        {"kind": "range", "key": "dbp_tail", "lo": 60.0, "hi": 300.0,
         "desc": "drawbar pull DROPS under the heavier load (147 vs 367 N: more motion resistance at deeper sinkage); generous band"}
      ]
    },
    {
      "turn": 3,
      "params": {"load": 5000.0, "rpm": 30.0, "long_speed": 0.2, "t_end": 5.0, "z_ref": -0.6193, "dbp_ref": 831.1, "slip_ref": 4.1873},
      "probe_vector": ["wheel-speed-tripling", "slip-sinkage-law", "kinematic-slip-check", "instrumented-observable"],
      "run": {
        "entry": "truth3.py",
        "env_id": "hip",
        "timeout": 900,
        "expect_csv": "out.csv",
        "expect_json_keys": ["z_settled", "dbp_tail", "slip_tail", "load"]
      },
      "L2_caps": {
        "vehicle_module": "pychrono.vehicle",
        "rig": "ChTireTestRig",
        "crm_terrain": "SetTerrainCRM",
        "normal_load": "SetNormalLoad",
        "speed_functions": "SetAngSpeedFunction"
      },
      "derive": [
        {"name": "z_settled", "kind": "mean", "csv": "out.csv", "column": "z", "time_column": "t", "t_min": 4.0},
        {"name": "slip_tail", "kind": "mean", "csv": "out.csv", "column": "slip", "time_column": "t", "t_min": 4.0},
        {"name": "dbp_tail", "kind": "mean", "csv": "out.csv", "column": "dbp", "time_column": "t", "t_min": 4.0}
      ],
      "L3": [
        {"kind": "range", "key": "slip_tail", "lo": 4.0, "hi": 4.4,
         "desc": "kinematic slip at 30 RPM vs 0.2 m/s: omega*R/v - 1 = 4.187 (exactly 3x the 10 RPM wheel speed); an unmodified 10 RPM candidate (0.7291) fails far low"},
        {"kind": "range", "key": "z_settled", "lo": -0.66, "hi": -0.60,
         "desc": "slip-sinkage: the spinning wheel excavates, settling deeper (calibrated -0.6193) than the 10 RPM run at the same load (turn 2: -0.5882, which fails high)"},
        {"kind": "range", "key": "dbp_tail", "lo": 400.0, "hi": 1300.0,
         "desc": "drawbar pull at the high-slip operating point (calibrated 831 N; generous band, SPH run-to-run variance)"}
      ]
    }
  ]
}
