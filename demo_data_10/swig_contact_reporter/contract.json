{
  "task": "swig_contact_reporter",
  "axis": "swig-python-cpp-extension",
  "simulator": "pychrono",
  "source": "Chrono demo_MBS_callbackNSC / contact-reporting idiom + static-equilibrium analytic",
  "probe_vector": ["swig-callback-subclass", "object-lifecycle", "contact-instrumentation"],
  "turn": 1,
  "run": {
    "entry": "truth1.py",
    "timeout": 120,
    "expect_json_keys": ["n_contacts", "normal_force"]
  },
  "L2_caps": {
    "report_callback": "ReportContactCallback",
    "report_contacts": "ReportAllContacts",
    "step_loop": "DoStepDynamics"
  },
  "L3": [
    {"kind": "min", "key": "n_contacts", "bound": 4,
     "desc": "callback invoked and produced data: >= N=4 sphere-ground contacts"},
    {"kind": "rel_tol", "key": "normal_force", "target": 39.24, "tol": 0.25,
     "desc": "summed normal reaction ~= N*m*g (static equilibrium), N=4, m~=1, g=9.81"}
  ]
}
